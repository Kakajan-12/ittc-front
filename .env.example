# --- Платформа регистрации (внешняя, чужая команда) ---
# Пакеты, промокоды, оплата, аккаунты участников.
NEXT_PUBLIC_API_URL=/api
API_PROXY_TARGET=https://api.event.oguzforum.com
NEXT_PUBLIC_BACKEND_URL=https://api.event.oguzforum.com
NEXT_PUBLIC_EVENT_ID=4

# --- Контент-API (ittc-back) ---
# Новости, спикеры, повестка, спонсоры, партнёры, FAQ, страницы,
# визовые заявки и заявки на сервисы.
NEXT_PUBLIC_CONTENT_API_URL=http://localhost:4000
# Период перезапроса контента страницами (ISR), секунды.
CONTENT_REVALIDATE_SECONDS=300
